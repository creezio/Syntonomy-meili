FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . ./
RUN npm run build
FROM node:22-alpine AS runtime
WORKDIR /app
ENV PORT=3000 HOST=0.0.0.0 NODE_ENV=production NUXT_MEILISEARCH_SINGLE_INSTANCE_PROXY_MODE=true
COPY --from=build --chown=node:node /app/.output/ ./
USER node
EXPOSE 3000
CMD ["node", "/app/server/index.mjs"]
